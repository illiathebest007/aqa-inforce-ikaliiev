{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["cypress", "node"],
    "skipLibCheck": true
  },
  "include": ["cypress.config.ts", "cypress/**/*.ts"]
}
